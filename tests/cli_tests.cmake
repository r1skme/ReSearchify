if(NOT DEFINED EXE OR NOT DEFINED WORK)
    message(FATAL_ERROR "EXE and WORK are required")
endif()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/исходники")
set(SOURCE "${WORK}/исходники")
set(INDEX "${WORK}/индекс")
string(ASCII 27 ESC)
string(ASCII 239 187 191 BOM)
file(WRITE "${SOURCE}/файл.cpp" "alpha${ESC}[31m literal thing\n")
file(WRITE "${WORK}/запрос.txt" "${BOM}alpha AND \"literal thing\"\r\n")
set(CHECKS 0)
function(run_expect expected)
    execute_process(COMMAND "${EXE}" ${ARGN}
        RESULT_VARIABLE actual OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "CLI exit ${actual}, expected ${expected}. Args: ${ARGN}\n${output}\n${errors}")
    endif()
    math(EXPR updated "${CHECKS}+1")
    set(CHECKS "${updated}" PARENT_SCOPE)
    set(LAST_OUT "${output}" PARENT_SCOPE)
    set(LAST_ERR "${errors}" PARENT_SCOPE)
endfunction()
run_expect(0 --help)
run_expect(0 create "${SOURCE}" "${INDEX}" --threads 2 --memory-mb 64)
run_expect(0 search "${INDEX}" --query-file "${WORK}/запрос.txt")
if(NOT LAST_OUT MATCHES "total_matches=1")
    message(FATAL_ERROR "UTF-8 query-file search did not find one file")
endif()
string(FIND "${LAST_OUT}" "\\x1b" escape_at)
if(escape_at EQUAL -1)
    message(FATAL_ERROR "ESC was not escaped in terminal output")
endif()
run_expect(0 search "${INDEX}" alpha --limit 0)
if(NOT LAST_OUT MATCHES "total_matches=1 returned=0")
    message(FATAL_ERROR "Count-only search is inconsistent")
endif()
run_expect(1 search "${INDEX}" absent)
run_expect(2 search "${INDEX}" "alpha AND (")
run_expect(2 search "${INDEX}" alpha --limit -1)
run_expect(0 stats "${INDEX}")
if(NOT LAST_OUT MATCHES "files=1 lines=1")
    message(FATAL_ERROR "CLI statistics mismatch")
endif()
run_expect(0 verify "${INDEX}")
run_expect(0 update "${INDEX}" --threads 2 --memory-mb 64)
if(NOT LAST_OUT MATCHES "generation=1" OR NOT LAST_OUT MATCHES "tokenized=0")
    message(FATAL_ERROR "Unchanged update created a new generation or tokenized files")
endif()
file(WRITE "${SOURCE}/файл.cpp" "omega literal thing\n")
run_expect(0 update "${INDEX}" --threads 2 --memory-mb 64)
run_expect(0 search "${INDEX}" omega)
run_expect(1 search "${INDEX}" alpha)
run_expect(2 create "${SOURCE}" "${INDEX}")
file(WRITE "${INDEX}/commit-2.bin" "damaged")
run_expect(0 search "${INDEX}" alpha)
if(NOT LAST_ERR MATCHES "Ignored generation 2")
    message(FATAL_ERROR "CLI hid the recovery warning")
endif()
file(MAKE_DIRECTORY "${INDEX}/writer.lock")
run_expect(2 recover "${INDEX}")
run_expect(0 recover "${INDEX}" --force)
if(EXISTS "${INDEX}/writer.lock")
    message(FATAL_ERROR "Recovery did not remove the lock")
endif()
file(REMOVE_RECURSE "${WORK}")
message(STATUS "CLI: ${CHECKS} process checks passed")
