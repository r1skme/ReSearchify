cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED EXE OR NOT DEFINED WORK)
    message(FATAL_ERROR "EXE and WORK are required")
endif()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/source")
file(WRITE "${WORK}/source/alpha.cpp" "alpha beta\nRenderFrame();\n")
function(invoke expected)
    execute_process(COMMAND "${EXE}" ${ARGN} WORKING_DIRECTORY "${WORK}/source"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT "${result}" STREQUAL "${expected}" OR NOT "${errors}" STREQUAL "")
        message(FATAL_ERROR "Bad process result ${result}, args=${ARGN}\n${output}\n${errors}")
    endif()
    string(REPLACE "\r\n" "\n" output "${output}")
    set(OUT "${output}" PARENT_SCOPE)
endfunction()
invoke(0 init . --json --memory-mb 64 --threads 2)
string(JSON status GET "${OUT}" status)
if(NOT status STREQUAL "ok")
    message(FATAL_ERROR "init did not return JSON success")
endif()
string(JSON unused ERROR_VARIABLE missing GET "${OUT}" stage_profile)
if(missing STREQUAL "NOTFOUND")
    message(FATAL_ERROR "Build profiling must be absent unless requested")
endif()
invoke(0 update --profile compact --profile-stages --threads 1 --json)
string(JSON profile_type TYPE "${OUT}" stage_profile)
if(NOT profile_type STREQUAL "OBJECT")
    message(FATAL_ERROR "--profile-stages did not return a build-stage object")
endif()
foreach(stage IN ITEMS enumeration_seconds queue_wait_seconds metadata_lookup_seconds validation_seconds capture_seconds posting_write_seconds catalog_seconds commit_seconds)
    string(JSON value GET "${OUT}" stage_profile "${stage}")
    if(value LESS 0)
        message(FATAL_ERROR "Negative build stage duration: ${stage}")
    endif()
endforeach()
invoke(0 update --no-profile-stages --threads 1 --json)
string(JSON unused ERROR_VARIABLE missing GET "${OUT}" stage_profile)
if(missing STREQUAL "NOTFOUND")
    message(FATAL_ERROR "--no-profile-stages must not expose optional profiling")
endif()
invoke(0 -s alpha --json)
string(JSON total GET "${OUT}" total)
if(NOT total EQUAL 1)
    message(FATAL_ERROR "-s alias failed")
endif()
string(JSON unused ERROR_VARIABLE missing GET "${OUT}" metrics profile)
if(missing STREQUAL "NOTFOUND")
    message(FATAL_ERROR "Search profiling must be absent by default")
endif()
invoke(0 -rs "Render[A-Za-z]*Frame" --json)
string(JSON total GET "${OUT}" total)
if(NOT total EQUAL 1)
    message(FATAL_ERROR "-rs alias failed")
endif()
invoke(0 -rs "Render[A-Za-z]*Frame" --json)
string(JSON total GET "${OUT}" total)
if(NOT total EQUAL 1)
    message(FATAL_ERROR "-rs must parse a regex, not a literal")
endif()
invoke(0 -l "RenderFrame();" --json)
string(JSON total GET "${OUT}" total)
if(NOT total EQUAL 1)
    message(FATAL_ERROR "-l alias failed")
endif()
string(JSON unprofiled_results GET "${OUT}" results)
invoke(0 -l "RenderFrame();" --threads 1 --profile --json)
string(JSON profiled_results GET "${OUT}" results)
string(JSON workers GET "${OUT}" metrics profile workers)
string(JSON opens GET "${OUT}" metrics profile content_opens)
if(NOT profiled_results STREQUAL unprofiled_results OR NOT workers EQUAL 1 OR opens LESS 1)
    message(FATAL_ERROR "Profiling/serial worker selection changed results or omitted I/O counters")
endif()
foreach(stage IN ITEMS planning_seconds candidate_seconds content_open_seconds content_read_seconds verification_seconds line_processing_seconds matching_seconds snippet_seconds)
    string(JSON value GET "${OUT}" metrics profile "${stage}")
    if(value LESS 0)
        message(FATAL_ERROR "Negative search stage duration: ${stage}")
    endif()
endforeach()
invoke(0 -l "RenderFrame();" --threads 0 --profile --json)
string(JSON adaptive_results GET "${OUT}" results)
if(NOT adaptive_results STREQUAL unprofiled_results)
    message(FATAL_ERROR "Adaptive search worker selection changed results")
endif()
invoke(0 -l "RenderFrame();" --threads 256 --no-profile --json)
string(JSON max_results GET "${OUT}" results)
string(JSON unused ERROR_VARIABLE missing GET "${OUT}" metrics profile)
if(NOT max_results STREQUAL unprofiled_results OR missing STREQUAL "NOTFOUND")
    message(FATAL_ERROR "Worker upper bound or --no-profile behavior is invalid")
endif()
foreach(invalid_threads IN ITEMS -1 257)
    invoke(2 find alpha --threads "${invalid_threads}" --json)
    string(JSON code GET "${OUT}" error code)
    if(NOT code STREQUAL "E_ARGUMENT")
        message(FATAL_ERROR "Invalid --threads must return a JSON E_ARGUMENT error")
    endif()
endforeach()
invoke(2 find alpha --profile-stages --json)
string(JSON code GET "${OUT}" error code)
if(NOT code STREQUAL "E_ARGUMENT")
    message(FATAL_ERROR "Build profiling flag must not be silently accepted for find")
endif()
invoke(0 -r alpha.cpp --lines 1:2 --json)
invoke(0 -f "*.cpp" --json)
invoke(0 -st --json)
invoke(0 -v --json)

# The documented safe first-run flow must never depend on the caller's cwd.
file(MAKE_DIRECTORY "${WORK}/safe-demo")
file(WRITE "${WORK}/safe-demo/example.cpp" "int RenderFrame() { return 42; }\n")
invoke(0 init "${WORK}/safe-demo" --json)
invoke(0 status --root "${WORK}/safe-demo" --json)
string(JSON demo_files GET "${OUT}" files)
if(NOT demo_files EQUAL 1)
    message(FATAL_ERROR "Explicit-root demo indexed the wrong directory")
endif()
invoke(0 find RenderFrame --root "${WORK}/safe-demo" --json)
string(JSON demo_total GET "${OUT}" total)
if(NOT demo_total EQUAL 1)
    message(FATAL_ERROR "Explicit-root demo search missed its known source file")
endif()
invoke(0 verify --root "${WORK}/safe-demo" --json)
invoke(0 find --help)
invoke(0 search --help)
invoke(0 schema find --json)
string(JSON schema GET "${OUT}" schema)
string(JSON threads_min GET "${schema}" inputSchema properties threads minimum)
string(JSON threads_max GET "${schema}" inputSchema properties threads maximum)
string(JSON threads_default GET "${schema}" inputSchema properties threads default)
string(JSON profile_type GET "${schema}" inputSchema properties profile type)
string(JSON profile_default GET "${schema}" inputSchema properties profile default)
if(NOT threads_min EQUAL 0 OR NOT threads_max EQUAL 256 OR NOT threads_default EQUAL 0 OR
   NOT profile_type STREQUAL "boolean" OR profile_default)
    message(FATAL_ERROR "Find schema does not describe adaptive workers and opt-in profiling")
endif()
invoke(0 schema init --json)
string(JSON profile_type GET "${OUT}" schema inputSchema properties profile type)
string(JSON stages_type GET "${OUT}" schema inputSchema properties profile_stages type)
string(JSON stages_default GET "${OUT}" schema inputSchema properties profile_stages default)
string(JSON threads_min GET "${OUT}" schema inputSchema properties threads minimum)
if(NOT profile_type STREQUAL "string" OR NOT stages_type STREQUAL "boolean" OR stages_default OR NOT threads_min EQUAL 1)
    message(FATAL_ERROR "Build schema confuses storage profile and timing profile")
endif()
invoke(0 find missing --json)
string(JSON total GET "${OUT}" total)
if(NOT total EQUAL 0)
    message(FATAL_ERROR "Machine empty result is not success")
endif()
file(WRITE "${WORK}/request.json" "{\"api_version\":1,\"command\":\"find\",\"query\":{\"and\":[{\"term\":\"alpha\"},{\"not\":{\"term\":\"absent\"}}]},\"memory_mb\":64}")
invoke(0 request --input "${WORK}/request.json")
string(JSON total GET "${OUT}" total)
if(NOT total EQUAL 1)
    message(FATAL_ERROR "Structured query returned wrong result")
endif()
file(WRITE "${WORK}/batch.jsonl" "{\"command\":\"find\",\"query\":\"alpha\",\"id\":1}\nnot-json\n{\"command\":\"read\",\"file\":\"alpha.cpp\",\"id\":3}\n")
invoke(2 batch --root . --input "${WORK}/batch.jsonl")
string(STRIP "${OUT}" records)
string(REPLACE "\n" "," records "${records}")
set(records "[${records}]")
string(JSON count LENGTH "${records}")
if(NOT count EQUAL 3)
    message(FATAL_ERROR "Batch must emit exactly one object per request")
endif()
string(JSON line GET "${records}" 0)
string(JSON status GET "${line}" status)
if(NOT status STREQUAL "ok")
    message(FATAL_ERROR "First batch response failed")
endif()
string(JSON line GET "${records}" 1)
string(JSON status GET "${line}" status)
if(NOT status STREQUAL "error")
    message(FATAL_ERROR "Bad batch line was not an error")
endif()
string(JSON line GET "${records}" 2)
string(JSON id GET "${line}" id)
if(NOT id EQUAL 3)
    message(FATAL_ERROR "Batch did not continue after an invalid request")
endif()
# One persistent writable session checks per-request profiling state and recovery
# from validation errors. JSON parsing also rejects stray timing/debug stdout.
file(WRITE "${WORK}/profile.jsonl" [=[{"command":"find","query":{"phrase":"RenderFrame();"},"threads":1,"profile":true,"id":"profiled"}
{"command":"find","query":"alpha","id":"default"}
{"command":"find","query":"alpha","threads":257,"id":"bad-range"}
{"command":"find","query":"alpha","profile":"true","id":"bad-type"}
{"command":"update","threads":1,"profile_stages":true,"id":"build-profile"}
{"command":"update","threads":1,"profile_stages":false,"id":"build-default"}
{"command":"find","query":"alpha","threads":0,"profile":false,"id":"after-update"}
]=])
invoke(2 serve --stdio --root . --allow-write --input "${WORK}/profile.jsonl")
string(STRIP "${OUT}" records)
string(REPLACE "\n" "," records "${records}")
set(records "[${records}]")
string(JSON count LENGTH "${records}")
if(NOT count EQUAL 7)
    message(FATAL_ERROR "Profiled JSONL session must emit exactly one object per request")
endif()
string(JSON workers GET "${records}" 0 metrics profile workers)
string(JSON unused ERROR_VARIABLE missing GET "${records}" 1 metrics profile)
if(NOT workers EQUAL 1 OR missing STREQUAL "NOTFOUND")
    message(FATAL_ERROR "Profiling state leaked between persistent JSONL requests")
endif()
foreach(record IN ITEMS 2 3)
    string(JSON status GET "${records}" "${record}" status)
    if(NOT status STREQUAL "error")
        message(FATAL_ERROR "Invalid JSONL profiling/thread request was accepted")
    endif()
endforeach()
string(JSON code GET "${records}" 2 error code)
if(NOT code STREQUAL "E_ARGUMENT")
    message(FATAL_ERROR "Out-of-range JSONL worker count must be E_ARGUMENT")
endif()
string(JSON stage_type TYPE "${records}" 4 stage_profile)
string(JSON unused ERROR_VARIABLE missing GET "${records}" 5 stage_profile)
if(NOT stage_type STREQUAL "OBJECT" OR missing STREQUAL "NOTFOUND")
    message(FATAL_ERROR "JSONL build profiling is not opt-in per request")
endif()
string(JSON total GET "${records}" 6 total)
string(JSON unused ERROR_VARIABLE missing GET "${records}" 6 metrics profile)
if(NOT total EQUAL 1 OR missing STREQUAL "NOTFOUND")
    message(FATAL_ERROR "JSONL search failed to recover after validation errors and updates")
endif()
file(WRITE "${WORK}/rpc.jsonl" "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-11-25\",\"capabilities\":{},\"clientInfo\":{\"name\":\"test\",\"version\":\"1\"}}}\n{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}\n{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\"}\n{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"name\":\"researchify_find\",\"arguments\":{\"query\":\"alpha\"}}}\n")
file(APPEND "${WORK}/rpc.jsonl" [=[{"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"researchify_find","arguments":{"query":{"phrase":"RenderFrame();"},"threads":1,"profile":true}}}
]=])
execute_process(COMMAND "${EXE}" mcp --stdio --root . WORKING_DIRECTORY "${WORK}/source"
    INPUT_FILE "${WORK}/rpc.jsonl" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT result EQUAL 0 OR NOT errors STREQUAL "")
    message(FATAL_ERROR "MCP process failed: ${result} ${errors}")
endif()
string(REPLACE "\r\n" "\n" output "${output}")
string(STRIP "${output}" records)
string(REPLACE "\n" "," records "${records}")
set(records "[${records}]")
string(JSON count LENGTH "${records}")
if(NOT count EQUAL 4)
    message(FATAL_ERROR "MCP stdout contains extra records or missing responses")
endif()
string(JSON line GET "${records}" 1)
string(JSON tools LENGTH "${line}" result tools)
if(NOT tools EQUAL 4)
    message(FATAL_ERROR "MCP did not expose four read-only tools")
endif()
string(JSON profile_type GET "${line}" result tools 0 inputSchema properties profile type)
string(JSON threads_max GET "${line}" result tools 0 inputSchema properties threads maximum)
if(NOT profile_type STREQUAL "boolean" OR NOT threads_max EQUAL 256)
    message(FATAL_ERROR "MCP find schema does not expose profiling and bounded workers")
endif()
string(JSON line GET "${records}" 2)
string(JSON total GET "${line}" result structuredContent total)
if(NOT total EQUAL 1)
    message(FATAL_ERROR "MCP tool returned wrong result")
endif()
string(JSON unused ERROR_VARIABLE missing GET "${line}" result structuredContent metrics profile)
if(missing STREQUAL "NOTFOUND")
    message(FATAL_ERROR "MCP should not profile queries by default")
endif()
string(JSON workers GET "${records}" 3 result structuredContent metrics profile workers)
string(JSON total GET "${records}" 3 result structuredContent total)
if(NOT workers EQUAL 1 OR NOT total EQUAL 1)
    message(FATAL_ERROR "MCP profiling request changed results or omitted worker counters")
endif()
message(STATUS "JSON request, batch recovery, discovery and actual MCP stdio processes passed")

execute_process(COMMAND "${EXE}" mcp --stdio --unsupported
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT result EQUAL 2 OR NOT output STREQUAL "" OR errors STREQUAL "")
    message(FATAL_ERROR "MCP startup failure contaminated protocol stdout")
endif()

# The documented known-edit flow must work through the real CLI/JSONL parser.
file(MAKE_DIRECTORY "${WORK}/update-demo")
file(WRITE "${WORK}/update-demo/old.cpp" "before\n")
file(WRITE "${WORK}/update-demo/other.cpp" "external_before\n")
invoke(0 init "${WORK}/update-demo" --threads 16 --memory-mb 64 --max-line-bytes 16384 --json)
file(WRITE "${WORK}/update-demo/old.cpp" "after\n")
file(WRITE "${WORK}/update-demo/other.cpp" "external_after\n")
file(WRITE "${WORK}/known-edit.jsonl" [=[{"id":1,"command":"update","changed_files":["old.cpp"],"mode":"strict"}
{"id":2,"command":"find","query":"after"}
{"id":3,"command":"find","query":"external_after"}
]=])
invoke(0 serve --stdio --root "${WORK}/update-demo" --allow-write --input "${WORK}/known-edit.jsonl")
string(STRIP "${OUT}" records)
string(REPLACE "\n" "," records "${records}")
set(records "[${records}]")
string(JSON workers GET "${records}" 0 workers)
string(JSON hashed GET "${records}" 0 hashed)
string(JSON global_scan GET "${records}" 0 global_scan)
string(JSON changed_total GET "${records}" 1 total)
string(JSON external_total GET "${records}" 2 total)
if(NOT workers EQUAL 1 OR NOT hashed EQUAL 1 OR global_scan OR NOT changed_total EQUAL 1 OR NOT external_total EQUAL 0)
    message(FATAL_ERROR "Known-edit JSONL scope or cached snapshot invalidation is incorrect")
endif()
file(RENAME "${WORK}/update-demo/old.cpp" "${WORK}/update-demo/new.cpp")
invoke(0 update --root "${WORK}/update-demo" --changed-file old.cpp --changed-file new.cpp --strict --json)
string(JSON added GET "${OUT}" added)
string(JSON removed GET "${OUT}" removed)
string(JSON hashed GET "${OUT}" hashed)
if(NOT added EQUAL 1 OR NOT removed EQUAL 1 OR NOT hashed EQUAL 1)
    message(FATAL_ERROR "Repeated --changed-file did not publish both sides of a rename")
endif()
file(REMOVE "${WORK}/update-demo/new.cpp")
invoke(0 update --root "${WORK}/update-demo" --changed-file new.cpp --strict --json)
string(JSON removed GET "${OUT}" removed)
string(JSON hashed GET "${OUT}" hashed)
if(NOT removed EQUAL 1 OR NOT hashed EQUAL 0)
    message(FATAL_ERROR "Known-file deletion was not reflected in the index")
endif()
invoke(0 update --root "${WORK}/update-demo" --strict --json)
string(JSON changed GET "${OUT}" changed)
string(JSON global_scan GET "${OUT}" global_scan)
if(NOT changed EQUAL 1 OR NOT global_scan)
    message(FATAL_ERROR "Full strict update failed to detect a change outside the known-edit list")
endif()
invoke(0 find external_after --root "${WORK}/update-demo" --json)
string(JSON total GET "${OUT}" total)
if(NOT total EQUAL 1)
    message(FATAL_ERROR "Full strict update did not publish the external edit")
endif()
